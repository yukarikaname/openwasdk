From 960ff2865c5b294138d75b9cbb297b7ca2097bbb Mon Sep 17 00:00:00 2001
From: Yukari Kaname <yukari@aliciaworks.com>
Date: Sat, 28 Nov 2026 19:34:14 +0800
Subject: [PATCH 04/10] coremessaging: forward CoreUICreate to the SDK session
 creator

---
 dlls/coremessaging/coremessaging.spec |  2 +-
 dlls/coremessaging/main.c             | 24 ++++++++++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/dlls/coremessaging/coremessaging.spec b/dlls/coremessaging/coremessaging.spec
index fb98c80..3bc2c0e 100644
--- a/dlls/coremessaging/coremessaging.spec
+++ b/dlls/coremessaging/coremessaging.spec
@@ -8,7 +8,7 @@
 @ stub CoreUICallSendVaList
 @ stub CoreUIConfigureTestHost
 @ stub CoreUIConfigureUserIntegration
-@ stub CoreUICreate
+@ stdcall CoreUICreate(ptr)
 @ stub CoreUICreateAnonymousStream
 @ stub CoreUICreateEx
 @ stub CoreUIInitializeTestService
diff --git a/dlls/coremessaging/main.c b/dlls/coremessaging/main.c
index 6fa2e28..7ca2628 100644
--- a/dlls/coremessaging/main.c
+++ b/dlls/coremessaging/main.c
@@ -285,3 +285,27 @@ HRESULT WINAPI CreateDispatcherQueueController( DispatcherQueueOptions options,
     TRACE( "created IDispatcherQueueController %p.\n", *queue_controller );
     return S_OK;
 }
+
+/***********************************************************************
+ *           CoreUICreate   (coremessaging.@)
+ *
+ * The SDK ships its own CoreMessaging as CoreMessagingXP.dll, where this entry point is
+ * called CoreMsgCreateSession. The App SDK's UDK layer falls back to the system name when
+ * it cannot use that file, so answering here by handing the call to the SDK's export is
+ * what puts the engine on the path Windows takes -- a real registrar and ALPC underneath.
+ */
+HRESULT WINAPI CoreUICreate( void **session )
+{
+    static HMODULE xp;
+    HRESULT (WINAPI *create)(ULONG, void **);
+
+    if (!xp && !(xp = LoadLibraryW( L"CoreMessagingXP.dll" ))) return E_NOTIMPL;
+    if (!(create = (void *)GetProcAddress( xp, "CoreMsgCreateSession" ))) return E_NOTIMPL;
+    {
+        /* The lifted IXP layer passes only the out pointer; the SDK's session creator wants
+         * flags first, and its default behaviour is what the layer expects. */
+        HRESULT hr = create( 0, session );
+        FIXME( "session %p -> %#lx\n", session ? *session : NULL, hr );
+        return hr;
+    }
+}
