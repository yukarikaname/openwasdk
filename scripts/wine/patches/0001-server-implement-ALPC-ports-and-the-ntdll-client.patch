+
+/***********************************************************************
+ * Wait completion packets (Windows 8+). A packet associates a waitable object with an I/O completion
+ * port: when the object becomes signaled, a completion is queued. Implemented on top of the thread pool
+ * wait machinery (RtlRegisterWait), so it lives on the PE side rather than as a syscall.
+ */
+struct wait_completion_packet
+{
+    HANDLE   event;        /* the handle we hand out: a real event object, so NtClose works */
+    HANDLE   wait;         /* RtlRegisterWait registration, or NULL */
+    HANDLE   iocp;
+    void    *key;
+    void    *apc_context;
+    NTSTATUS status;
+    ULONG_PTR information;
+    LONG     pending;
+};
+
+static RTL_CRITICAL_SECTION packets_cs;
+static RTL_CRITICAL_SECTION_DEBUG packets_cs_debug =
+{
+    0, 0, &packets_cs,
+    { &packets_cs_debug.ProcessLocksList, &packets_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": packets_cs") }
+};
+static RTL_CRITICAL_SECTION packets_cs = { &packets_cs_debug, -1, 0, 0, 0, 0 };
+static struct wait_completion_packet **packets;
+static unsigned int packets_count, packets_size;
+
+static struct wait_completion_packet *find_packet( HANDLE handle )
+{
+    unsigned int i;
+    for (i = 0; i < packets_count; i++) if (packets[i]->event == handle) return packets[i];
+    return NULL;
+}
+
+static void CALLBACK packet_wait_callback( void *context, BOOLEAN timed_out )
+{
+    struct wait_completion_packet *packet = context;
+
+    if (InterlockedExchange( &packet->pending, 0 ))
+    {
+        TRACE( "packet %p signaled, posting completion to %p\n", packet->event, packet->iocp );
+        NtSetIoCompletion( packet->iocp, (ULONG_PTR)packet->key, (ULONG_PTR)packet->apc_context,
+                           packet->status, packet->information );
+    }
+}
+
+/******************************************************************************
+ *              NtCreateWaitCompletionPacket  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCreateWaitCompletionPacket( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr )
+{
+    struct wait_completion_packet *packet;
+    NTSTATUS status;
+
+    TRACE( "%p %#x %p\n", handle, (unsigned int)access, attr );
+
+    if (!(packet = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*packet) ))) return STATUS_NO_MEMORY;
+    if ((status = NtCreateEvent( &packet->event, EVENT_ALL_ACCESS, NULL, NotificationEvent, FALSE )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, packet );
+        return status;
+    }
+    RtlEnterCriticalSection( &packets_cs );
+    if (packets_count == packets_size)
+    {
+        unsigned int new_size = packets_size ? packets_size * 2 : 16;
+        struct wait_completion_packet **new_packets = packets ? RtlReAllocateHeap( GetProcessHeap(), 0, packets, new_size * sizeof(*packets) )
+                                                              : RtlAllocateHeap( GetProcessHeap(), 0, new_size * sizeof(*packets) );
+        if (new_packets) { packets = new_packets; packets_size = new_size; }
+    }
+    if (packets_count < packets_size) packets[packets_count++] = packet;
+    RtlLeaveCriticalSection( &packets_cs );
+    *handle = packet->event;
+    return STATUS_SUCCESS;
+}
+
+/******************************************************************************
+ *              NtAssociateWaitCompletionPacket  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtAssociateWaitCompletionPacket( HANDLE handle, HANDLE iocp, HANDLE target, void *key,
+                                                 void *apc_context, NTSTATUS status, ULONG_PTR information,
+                                                 BOOLEAN *already_signaled )
+{
+    struct wait_completion_packet *packet;
+    NTSTATUS ret;
+
+    TRACE( "%p %p %p %p %p %#x %Ix %p\n", handle, iocp, target, key, apc_context, (unsigned int)status,
+           information, already_signaled );
+
+    RtlEnterCriticalSection( &packets_cs );
+    packet = find_packet( handle );
+    RtlLeaveCriticalSection( &packets_cs );
+    if (!packet) return STATUS_INVALID_HANDLE;
+    if (packet->wait)
+    {
+        /* Still armed: associating twice is an error. Fired: its completion has been queued, and on Windows the
+         * packet can be associated again - CoreMessaging re-arms its timer's packet after every expiry. Refusing
+         * that left its UI-thread timers firing once and never again, which byte patches in CoreMessaging.dll
+         * (a mailbox between SetRelative and DrainSignaledWaits) worked around. */
+        if (packet->pending) return STATUS_INVALID_PARAMETER;
+        RtlDeregisterWaitEx( packet->wait, NULL );
+        packet->wait = NULL;
+    }
+
+    packet->iocp = iocp; packet->key = key; packet->apc_context = apc_context;
+    packet->status = status; packet->information = information;
+    if (already_signaled) *already_signaled = FALSE;
+
+    /* if the object is already signaled, report it now and queue the completion */
+    if (already_signaled)
+    {
+        LARGE_INTEGER zero = { .QuadPart = 0 };
+        NTSTATUS wait = NtWaitForSingleObject( target, FALSE, &zero );
+        if (wait == STATUS_WAIT_0)
+        {
+            *already_signaled = TRUE;
+            NtSetIoCompletion( iocp, (ULONG_PTR)key, (ULONG_PTR)apc_context, status, information );
+            return STATUS_SUCCESS;
+        }
+    }
+    packet->pending = 1;
+    ret = RtlRegisterWait( &packet->wait, target, packet_wait_callback, packet, INFINITE, WT_EXECUTEONLYONCE );
+    if (ret) packet->pending = 0;
+    return ret;
+}
+
+/******************************************************************************
+ *              NtCancelWaitCompletionPacket  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCancelWaitCompletionPacket( HANDLE handle, BOOLEAN remove_signaled )
+{
+    struct wait_completion_packet *packet;
+    HANDLE wait;
+
+    TRACE( "%p %d\n", handle, remove_signaled );
+
+    RtlEnterCriticalSection( &packets_cs );
+    packet = find_packet( handle );
+    RtlLeaveCriticalSection( &packets_cs );
+    if (!packet) return STATUS_INVALID_HANDLE;
+
+    if (!(wait = packet->wait)) return STATUS_CANCELLED;
+    packet->wait = NULL;
+    if (!InterlockedExchange( &packet->pending, 0 ))
+    {
+        RtlDeregisterWaitEx( wait, NULL );
+        return STATUS_SUCCESS;   /* completion already queued */
+    }
+    RtlDeregisterWaitEx( wait, NULL );
+    return STATUS_CANCELLED;
+}
