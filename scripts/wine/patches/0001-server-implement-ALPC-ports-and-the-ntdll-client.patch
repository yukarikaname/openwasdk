+/***********************************************************************
+ *           TpSetWaitEx    (NTDLL.@)
+ *
+ * SetThreadpoolWaitEx. Reserved is unused on current Windows.
+ */
+NTSTATUS WINAPI TpSetWaitEx( TP_WAIT *wait, HANDLE handle, LARGE_INTEGER *timeout, void *reserved )
+{
+    TRACE( "%p %p %p %p\n", wait, handle, timeout, reserved );
