+
+        RtlGetVersion( &info );
+        {
+            UNICODE_STRING name;
+            OBJECT_ATTRIBUTES attr;
+            HANDLE key;
+            char buf[sizeof(KEY_VALUE_PARTIAL_INFORMATION) + sizeof(DWORD)];
+            DWORD len;
