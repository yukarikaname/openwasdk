+    SERVER_START_REQ( alpc_query_info )
+    {
+        req->handle = wine_server_obj_handle( port_handle );
+        if (!(status = wine_server_call( req )))
+        {
+            ALPC_BASIC_INFORMATION *basic = info;
+            basic->Flags       = reply->flags;
+            basic->SequenceNo  = reply->sequence;
