From eed6c83bdc77e045142b56308079e09e4f6f6708 Mon Sep 17 00:00:00 2001
From: Yukari Kaname <yukari@aliciaworks.com>
Date: Sat, 28 Nov 2026 18:50:16 +0800
Subject: [PATCH 7/8] wintypes: give property values their runtime class name

A value from PropertyValue is an IReference of its primitive type, and the projection
asks for the class name to decide what the managed object is. Answering E_NOTIMPL left
the cast with IInspectable, so casting a resource value to double threw
InvalidCastException and the application ended during resource initialisation.
---
 dlls/wintypes/main.c | 34 ++++++++++++++++++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/dlls/wintypes/main.c b/dlls/wintypes/main.c
index 2c5d4c45f..3355c6852 100644
--- a/dlls/wintypes/main.c
+++ b/dlls/wintypes/main.c
@@ -627,10 +627,40 @@ static HRESULT STDMETHODCALLTYPE property_value_GetIids(IPropertyValue *iface, U
     return E_NOTIMPL;
 }
 
+static const WCHAR *property_type_class_name( PropertyType type )
+{
+    switch (type)
+    {
+    case PropertyType_UInt8:    return L"Windows.Foundation.IReference`1<UInt8>";
+    case PropertyType_Int16:    return L"Windows.Foundation.IReference`1<Int16>";
+    case PropertyType_UInt16:   return L"Windows.Foundation.IReference`1<UInt16>";
+    case PropertyType_Int32:    return L"Windows.Foundation.IReference`1<Int32>";
+    case PropertyType_UInt32:   return L"Windows.Foundation.IReference`1<UInt32>";
+    case PropertyType_Int64:    return L"Windows.Foundation.IReference`1<Int64>";
+    case PropertyType_UInt64:   return L"Windows.Foundation.IReference`1<UInt64>";
+    case PropertyType_Single:   return L"Windows.Foundation.IReference`1<Single>";
+    case PropertyType_Double:   return L"Windows.Foundation.IReference`1<Double>";
+    case PropertyType_Char16:   return L"Windows.Foundation.IReference`1<Char16>";
+    case PropertyType_Boolean:  return L"Windows.Foundation.IReference`1<Boolean>";
+    case PropertyType_String:   return L"Windows.Foundation.IReference`1<String>";
+    case PropertyType_DateTime: return L"Windows.Foundation.IReference`1<DateTime>";
+    case PropertyType_TimeSpan: return L"Windows.Foundation.IReference`1<TimeSpan>";
+    case PropertyType_Guid:     return L"Windows.Foundation.IReference`1<Guid>";
+    case PropertyType_Point:    return L"Windows.Foundation.IReference`1<Point>";
+    case PropertyType_Size:     return L"Windows.Foundation.IReference`1<Size>";
+    case PropertyType_Rect:     return L"Windows.Foundation.IReference`1<Rect>";
+    default:                    return L"Windows.Foundation.IPropertyValue";
+    }
+}
+
 static HRESULT STDMETHODCALLTYPE property_value_GetRuntimeClassName(IPropertyValue *iface, HSTRING *class_name)
 {
-    FIXME("iface %p, class_name %p stub!\n", iface, class_name);
-    return E_NOTIMPL;
+    struct property_value *impl = impl_from_IPropertyValue(iface);
+    const WCHAR *name = property_type_class_name( impl->type );
+
+    TRACE("iface %p -> %s\n", iface, debugstr_w(name));
+    if (!class_name) return E_POINTER;
+    return WindowsCreateString( name, wcslen(name), class_name );
 }
 
 static HRESULT STDMETHODCALLTYPE property_value_GetTrustLevel(IPropertyValue *iface, TrustLevel *trust_level)
