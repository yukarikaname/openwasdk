From 7430049fc1c63d9f81014ccb61e757da273e5c10 Mon Sep 17 00:00:00 2001
From: Yukari Kaname <yukari@aliciaworks.com>
Date: Sat, 28 Nov 2026 19:34:14 +0800
Subject: [PATCH 08/10] conhost: keep a text cell when no font is found

---
 programs/conhost/window.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/programs/conhost/window.c b/programs/conhost/window.c
index f8fc701..5180d69 100644
--- a/programs/conhost/window.c
+++ b/programs/conhost/window.c
@@ -884,7 +884,13 @@ static void set_first_font( struct console *console, struct console_config *conf
     fc.lf.lfHeight = config->cell_height;
     fc.lf.lfWidth = config->cell_width;
     if (!fc.weight || !set_console_font( console, &fc.lf ))
+    {
         ERR("Unable to find a valid console font\n");
+        /* Without a font backend every look-up fails and the cell size stays zero; the
+         * drawing code divides by it. Keep a text cell so the arithmetic stays defined. */
+        if (!console->active->font.width) console->active->font.width = 8;
+        if (!console->active->font.height) console->active->font.height = 16;
+    }
 
     /* Update active configuration */
     config->cell_width  = console->active->font.width;
