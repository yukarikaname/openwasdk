From cabe2af0a6fb26374d93afdaa9a014bba54376d6 Mon Sep 17 00:00:00 2001
From: Yukari Kaname <yukari@aliciaworks.com>
Date: Sat, 28 Nov 2026 19:29:29 +0800
Subject: [PATCH 05/10] combase: answer IAgileObject from the free-threaded
 marshaler

---
 dlls/combase/marshal.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
index 6e3d35c..44ffea1 100644
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -179,6 +179,13 @@ static HRESULT WINAPI ftmarshaler_inner_QueryInterface(IUnknown *iface, REFIID r
 
     if (IsEqualIID(&IID_IUnknown, riid))
         *obj = &marshaler->IUnknown_inner;
+    else if (IsEqualIID(&IID_IAgileObject, riid))
+    {
+        /* The free-threaded marshaler is agile by definition, and a caller that asks for
+         * the marker interface is asking whether it may use the object from any
+         * apartment. Answering no sends some of them into a retry loop. */
+        *obj = &marshaler->IUnknown_inner;
+    }
     else if (IsEqualIID(&IID_IMarshal, riid))
         *obj = &marshaler->IMarshal_iface;
     else
