+/***********************************************************************
+ *       NtQueryCompositionInputSinkLuid (win32u.so)
+ *
+ * Returns a stable LUID for a composition input sink handle. XAML looks
+ * this up after create_composition_input_sink; a unique-enough value is
+ * enough for hit-testing bookkeeping.
+ */
+NTSTATUS WINAPI NtQueryCompositionInputSinkLuid( HANDLE sink, LUID *luid )
+{
+    if (!luid) return STATUS_INVALID_PARAMETER;
+    luid->LowPart = HandleToULong( sink );
+    luid->HighPart = 0x55495043; /* 'CPIU' */
+    return STATUS_SUCCESS;
+}
