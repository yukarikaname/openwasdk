+
+/***********************************************************************
+ *           NtUserInitThreadCoreMessagingIocp2   (win32u.@)
+ *
+ * CoreMessaging asks for an I/O completion port tied to the calling thread's message queue: whenever
+ * the queue becomes signaled, a completion is posted so its event loop knows to drain Win32 messages.
+ * The completion carries ApcContext with bit 31 set, which is how CoreMessaging tells queue
+ * notifications from its wait completion packets. Returns the port handle; hwnd is the thread's
+ * dispatcher window and the parameter block is opaque to us.
+ */
+void * WINAPI NtUserInitThreadCoreMessagingIocp2( HWND hwnd, void *params )
+{
+    unsigned int status;
+    HANDLE iocp;
+
+    FIXME( "%p %p: semi-stub\n", hwnd, params );
+    NtUserGetQueueStatus( 0 );   /* make sure the thread queue exists */
+    if ((status = NtCreateIoCompletion( &iocp, IO_COMPLETION_ALL_ACCESS, NULL, 0 )))
+    {
+        WARN( "creating completion port failed, status %#x\n", status );
+        return NULL;
+    }
+    SERVER_START_REQ( set_queue_completion )
+    {
+        req->completion = wine_server_obj_handle( iocp );
+        req->key        = 0;
+        req->value      = 0x80000000;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (status)
+    {
+        WARN( "attaching completion port %p failed, status %#x\n", iocp, status );
+        NtClose( iocp );
+        return NULL;
+    }
+    TRACE( "thread %04x: port %p\n", (int)GetCurrentThreadId(), iocp );
+    /* our own handle for the message wait, which CoreMessaging closing its copy cannot invalidate */
+    {
+        struct user_thread_info *info = get_user_thread_info();
+        HANDLE dup;
+        if (!NtDuplicateObject( GetCurrentProcess(), iocp, GetCurrentProcess(), &dup, 0, 0, DUPLICATE_SAME_ACCESS ))
+        {
+            if (info->coremsg_iocp) NtClose( info->coremsg_iocp );
+            info->coremsg_iocp = dup;
+            info->coremsg_hwnd = hwnd;
+        }
+    }
+    return iocp;
+}
+
+/***********************************************************************
+ *           NtUserInitThreadCoreMessagingIocp   (win32u.@)
+ */
+void * WINAPI NtUserInitThreadCoreMessagingIocp( HWND hwnd, void *params )
+{
+    return NtUserInitThreadCoreMessagingIocp2( hwnd, params );
+}
+
+/***********************************************************************
+ *           NtUserDrainThreadCoreMessagingCompletions2   (win32u.@)
+ */
+DWORD WINAPI NtUserDrainThreadCoreMessagingCompletions2( void *cookie )
+{
+    unsigned int status;
+
+    TRACE( "%p\n", cookie );
+    /* Empty the port: CoreMessaging's user-integrated wait (Win32EventLoopBridge) never waits on it itself. A
+     * completion on it - a wait completion packet firing for one of its timers or waits - wakes the thread's
+     * message wait (NtUserMsgWaitForMultipleObjectsEx), after which CoreMessaging calls this and then checks its
+     * registered waits (UserAdapter::ProcessPendingWaitsCommon). Left on the port, the completion kept the wait
+     * signalled for ever. */
+    drain_coremsg_port();
+    SERVER_START_REQ( drain_queue_completion )
+    {
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    /* nonzero on success: CoreMessaging's DrainSignaledIocpWaits fail-fasts on 0 (FailFast::ForWin32, E_FAIL with no
+     * last error), which a CoreMessaging byte patch used to jump over */
+    return !status;
+}
+
+/***********************************************************************
+ *           NtUserDrainThreadCoreMessagingCompletions   (win32u.@)
+ */
+DWORD WINAPI NtUserDrainThreadCoreMessagingCompletions( void *cookie )
+{
+    return NtUserDrainThreadCoreMessagingCompletions2( cookie );
+}
+
+/***********************************************************************
+ *           NtUserGetQueueStatusReadonly   (win32u.@)
+ */
+DWORD WINAPI NtUserGetQueueStatusReadonly( UINT flags )
+{
+    DWORD ret;
+    SERVER_START_REQ( get_queue_status )
+    {
+        req->clear_bits = 0;
+        wine_server_call( req );
+        ret = MAKELONG( reply->changed_bits & flags, reply->wake_bits & flags );
+    }
+    SERVER_END_REQ;
+    return ret;
+}
