diff --git a/dlls/win32u/defwnd.c b/dlls/win32u/defwnd.c
index a88304f..0085c1f 100644
--- a/dlls/win32u/defwnd.c
+++ b/dlls/win32u/defwnd.c
@@ -2643,6 +2643,67 @@ LRESULT default_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam,
         }
         break;
 
+    case WM_QUERYUISTATE:
+        {
+            WND *win;
+            if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) break;
+            result = win->ui_state & (UISF_HIDEFOCUS | UISF_HIDEACCEL | UISF_ACTIVE);
+            release_win_ptr( win );
+        }
+        break;
+
+    case WM_CHANGEUISTATE:
+        {
+            /* Keyboard-cue state, like Windows: a child forwards to its top-level window, which
+             * applies the change and broadcasts WM_UPDATEUISTATE down its tree. UIS_INITIALIZE
+             * hides focus rectangles and accelerator underlines unless keyboard cues are on. */
+            WND *win;
+            HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+            UINT action = LOWORD(wparam), flags = HIWORD(wparam), old, new;
+
+            if (parent && parent != get_desktop_window())
+            {
+                send_message( parent, msg, wparam, lparam );
+                break;
+            }
+            if (action == UIS_INITIALIZE)
+            {
+                BOOL cues = FALSE;
+                NtUserSystemParametersInfo( SPI_GETKEYBOARDCUES, 0, &cues, 0 );
+                flags = cues ? 0 : (UISF_HIDEFOCUS | UISF_HIDEACCEL);
+                action = UIS_SET;
+            }
+            flags &= UISF_HIDEFOCUS | UISF_HIDEACCEL | UISF_ACTIVE;
+            if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) break;
+            old = win->ui_state & ~WIN_UISTATE_INITIALIZED;
+            new = action == UIS_SET ? old | flags : action == UIS_CLEAR ? old & ~flags : old;
+            win->ui_state |= WIN_UISTATE_INITIALIZED;
+            release_win_ptr( win );
+            if (new != old || LOWORD(wparam) == UIS_INITIALIZE)
+                send_message( hwnd, WM_UPDATEUISTATE, MAKEWPARAM( action, flags ), 0 );
+        }
+        break;
+
+    case WM_UPDATEUISTATE:
+        {
+            WND *win;
+            HWND *list;
+            UINT action = LOWORD(wparam), flags = HIWORD(wparam);
+
+            flags &= UISF_HIDEFOCUS | UISF_HIDEACCEL | UISF_ACTIVE;
+            if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) break;
+            if (action == UIS_SET) win->ui_state |= flags;
+            else if (action == UIS_CLEAR) win->ui_state &= ~flags;
+            release_win_ptr( win );
+            if ((list = list_window_children( hwnd )))
+            {
+                HWND *child;
+                for (child = list; *child; child++) send_message( *child, msg, wparam, lparam );
+                free( list );
+            }
+        }
+        break;
+
     case WM_GETTEXT:
         if (wparam)
         {
