+/* tell CoreMessaging's completion port that the queue has work, if one is attached */
+static void queue_signal_completion( struct msg_queue *queue )
+{
+    if (queue->completion && !queue->completion_posted)
+    {
+        queue->completion_posted = 1;
+        add_completion( queue->completion, queue->completion_key, queue->completion_value, STATUS_SUCCESS, 0 );
+    }
+}
+
+/* signal the queue sync, and the completion port if one is attached */
+static void queue_signal( struct msg_queue *queue )
+{
+    signal_sync( queue->sync );
+    queue_signal_completion( queue );
+}
