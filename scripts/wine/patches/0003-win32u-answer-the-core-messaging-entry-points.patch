         }
         if (tmp && !*tmp) *tmp = ' ';
         if (!(key = malloc( sizeof(*key) ))) break;
@@ -6650,6 +6647,30 @@ static void update_external_font_keys(void)
             set_reg_value( hkey, value, REG_SZ, file, len );
         }
     }
+    /* Fonts in C:\windows\fonts are listed under their bare file names, as Windows lists them.
+     * Nothing else registers them here, and dwrite builds its system collection from this key. */
+    {
+        WCHAR fonts_dir[MAX_PATH];
+        size_t dir_len;
+
+        get_fonts_win_dir_path( NULL, fonts_dir );
+        dir_len = wcslen( fonts_dir );
+        WINE_RB_FOR_EACH_ENTRY( family, &family_name_tree, struct gdi_font_family, name_entry )
+        {
+            LIST_FOR_EACH_ENTRY( face, &family->faces, struct gdi_font_face, entry )
+            {
+                if (face->flags & ADDFONT_EXTERNAL_FONT) continue;
+                if (!face->file || wcslen( face->file ) <= dir_len || wcsnicmp( face->file, fonts_dir, dir_len )) continue;
+                if (!face->full_name) continue;
+                lstrcpyW( value, face->full_name );
+                if (face->scalable) lstrcatW( value, true_type_suffixW );
+                file = face->file + dir_len;
+                len = (lstrlenW(file) + 1) * sizeof(WCHAR);
+                set_reg_value( winnt_key, value, REG_SZ, file, len );
+                set_reg_value( win9x_key, value, REG_SZ, file, len );
+            }
+        }
+    }
     NtClose( win9x_key );
     NtClose( winnt_key );
     NtClose( hkey );
