<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gate C: the declarative C# path with no XAML of its own.

    `WindowsPackageType=None` keeps the app out of MSIX, so there is no package
    identity to arrange before it can start, and `WindowsAppSDKSelfContained`
    puts the App SDK next to the executable, which is also where our DLLs go
    when we run it under Wine.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
    <RootNamespace>GateC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.18" />
  </ItemGroup>

</Project>
